# ---------------------------------------------------------------------------
# AntiBioTix - single environment file
#
# Copy to `.env` at the repository root and fill in. Every endpoint, key and
# model id the system uses is read from here, through backend/config.py. Nothing
# reads os.getenv() at its own call site.
#
# A real environment variable always wins over this file, so container and CI
# secrets are never overridden by a checked-out .env.
#
# THE SYSTEM RUNS WITH THIS FILE ABSENT. No key configured means: web evidence
# off, filtration agent refuses every result rather than admitting unassessed
# sources, retrieval on the local offline model. All 30 clinical safety rules
# fire exactly as they do today - they never read anything in this file.
# ---------------------------------------------------------------------------

# --- Agent LLM (NVIDIA NIM, OpenAI-compatible) -----------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AGENT_LLM_MODEL=NVIDIA-Nemotron-3-Super-120B-A12B-BF16
AGENT_LLM_TIMEOUT_S=45
# Zero by default: a filtration verdict that changes between runs on the same
# input cannot be audited, and auditability is this layer's entire claim.
AGENT_LLM_TEMPERATURE=0

# --- Retrieval embeddings --------------------------------------------------
# local  = all-MiniLM-L6-v2, offline on CPU, what the current index is built with
# nvidia = hosted, stronger on clinical text, requires connectivity
#
# CHANGING THIS REQUIRES A MIGRATION. An index built with one backend cannot be
# queried by another - the store refuses by recorded model name rather than
# returning wrong neighbours. Switch by running:
#     python -m scripts.migrate_embeddings --to nvidia
# which builds the new index beside the old one and swaps only on success.
EMBEDDING_BACKEND=local
NVIDIA_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v1

# Which sentence-transformers model the local backend loads.
# A HARDWARE decision, not a preference -- see the table in backend/rag/embeddings.py.
#   all-MiniLM-L6-v2          ~90 MB   384 dim   CPU, current index
#   Qwen/Qwen3-Embedding-0.6B ~1.2 GB 1024 dim   CPU-feasible upgrade
#   Qwen/Qwen3-Embedding-4B    ~8 GB  2560 dim   GPU strongly preferred
#   Qwen/Qwen3-Embedding-8B   ~16 GB  4096 dim   GPU required in practice
# Changing this requires: python -m scripts.migrate_embeddings --to local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Web evidence path (rank 5) --------------------------------------------
# Off by default. On, every result still passes the filtration agent, and
# anything it admits is labelled as web-sourced wherever it is shown.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
# Only used by the keyed providers; duckduckgo has its own endpoint.
WEB_SEARCH_BASE_URL=https://api.tavily.com/search
WEB_SEARCH_MAX_RESULTS=5

# Below this clinical-validity score a web result is rejected outright rather
# than passed forward with a caveat. Same principle as the 0.45 retrieval
# relevance floor: a weak source shown as evidence is worse than silence.
WEB_FILTER_ACCEPT_THRESHOLD=0.6

# --- LLM completion budget -------------------------------------------------
# COVERS THE MODEL'S REASONING AS WELL AS ITS ANSWER. The Nemotron models think
# before they answer and both are charged against this number. Sized for the JSON
# alone, the reasoning eats the budget and the response arrives truncated with no
# JSON in it -- which is why the composing agent silently fell back to extractive
# mode on every query until this was raised. 2400 fits the largest prompt here.
AGENT_LLM_MAX_TOKENS=2400
# The ceiling a truncation retry may raise the budget to, so a model that will
# not stop cannot bill indefinitely against one request.
AGENT_LLM_MAX_TOKENS_CEILING=6000

# --- Persistence -----------------------------------------------------------
# Empty = the SQLite file beside the repository. Set a postgresql:// URL for a
# real deployment. Declared here so no endpoint this system talks to is
# configured anywhere else.
DATABASE_URL=

# --- Search pipeline (parallel fan-out) ------------------------------------
# The vector search and the web search are dispatched together. This is the wall
# clock the SLOWER branch gets before the pipeline proceeds without it: a vendor
# that hangs must degrade to corpus-only evidence, never to a spinner in front of
# a clinician.
SEARCH_PARALLEL_TIMEOUT_S=40
# How many passages reach the composing agent after precedence ordering.
SEARCH_MAX_PASSAGES=8

# --- Document ingestion pipeline -------------------------------------------
# Where the converted Markdown is written, and served back from at
# /api/agents/documents/{id}/markdown. Kept beside the RAG corpus so a document's
# indexed chunks and the Markdown they were cut from live together.
MARKDOWN_OUTPUT_DIR=

# Page cap for PDF conversion. A 900-page compendium converts in minutes and
# blocks the request that long. 0 = no cap.
MARKDOWN_MAX_PAGES=400

# How much converted Markdown the validating model is shown. The whole document
# would not fit a context window, and a validator that truncates silently gives a
# verdict covering less than it appears to.
INGEST_VALIDATION_SAMPLE_CHARS=12000

# Below this, the model's own confidence in its review is reported as a warning
# on the document. Never blocks: low confidence is a reason to tell the reader,
# not a finding about the document.
INGEST_VALIDATION_MIN_CONFIDENCE=0.5

# STRICT MODE. On, a document is refused unless a model actually reviewed its
# content -- no key, no ingestion. Off by default so the system still runs fully
# offline, in which case the seven structural rules run alone and every result
# says so rather than implying a review happened.
INGEST_VALIDATION_REQUIRE_MODEL=false
