# --- database (regenerate with: python -m backend.seed_data) ---
*.db
*.sqlite
*.sqlite3

# --- python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
venv/
.venv/
.env

# --- fetched source data (regenerate with: python scripts/ingest_dailymed.py --all) ---
.cache/

# --- editor / OS ---
.DS_Store
.idea/
.vscode/
*.swp

# NOTE: backend/guidelines/data/rag/ IS committed on purpose. It holds the
# ingested guideline corpus and its vector index, so the app works immediately
# after clone with no PDFs and no re-embedding step.

# --- scratch / throwaway verification scripts ---
scratch/

# --- frontend build tooling ---
frontend-src/node_modules/
frontend-src/*.tsbuildinfo

# NOTE: frontend/ is the Vite BUILD OUTPUT and IS committed on purpose, for the
# same reason the RAG corpus is: backend/app.py serves it directly, so the app
# must work straight after clone without an npm install + build step.
# Source lives in frontend-src/. The pre-migration vanilla UI is kept in
# frontend-legacy/ as the reference the console markup is generated from.
